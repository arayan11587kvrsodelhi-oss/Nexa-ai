# PostgreSQL connection used by the app and by drizzle-kit migrations.
# Required. There is no built-in fallback: drizzle.config.ts fails loudly
# without it, so no credential is ever committed to the repository.
# Supply your own value; the shape is:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
# For a local dev database the OS user often needs no password, e.g.
#   postgresql://localhost/nexa_ai
DATABASE_URL=

# Optional inference defaults (Ollama is primary)
DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# FreeLLMAPI — optional external OpenAI-compatible provider.
# Server-side only: these values are never sent to the browser and are never
# stored in the database. Leave FREELLMAPI_BASE_URL empty to keep the provider
# disabled. No production host is hard-coded; point it at your own installation.
# FREELLMAPI_API_KEY is optional because a local installation may not require one.
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
# Optional: default model id when the profile router does not pick one.
# Otherwise the first model reported by GET /v1/models is used.
FREELLMAPI_MODEL=

# Demo inference sandbox. NEVER enable in production.
# When true, an unreachable Ollama may be served by canned demo output.
# FreeLLMAPI is never served by the demo sandbox, whatever this is set to.
ALLOW_DEMO_FALLBACK=false

# ---------------------------------------------------------------------------
# API key pepper. REQUIRED in production.
# A high-entropy secret mixed into every API key digest. Rotating it
# invalidates every existing key. Generate with:  openssl rand -hex 32
# Never commit a real value.
NEXA_API_KEY_PEPPER=

# ---------------------------------------------------------------------------
# Distributed rate limiting. Counters live in PostgreSQL, so these quotas are
# enforced across every serverless instance. All are optional; the defaults
# below apply when unset. See docs/ENVIRONMENT.md.
# These are abuse/quota controls, not a security guarantee.
# ---------------------------------------------------------------------------

# /v1/chat/completions, per API key (the endpoint that spends upstream quota).
NEXA_V1_KEY_RATE_LIMIT=60
NEXA_V1_KEY_RATE_WINDOW_SECONDS=60

# /v1/chat/completions, per source address.
NEXA_V1_IP_RATE_LIMIT=120
NEXA_V1_IP_RATE_WINDOW_SECONDS=60

# GET /v1/models, per key. Fails open if the limiter store is unreachable.
NEXA_V1_MODELS_RATE_LIMIT=60
NEXA_V1_MODELS_RATE_WINDOW_SECONDS=60

# GET /v1/health, per key. Fails open so a monitor still works during a
# database blip. Raise this if your monitor polls more often than once a minute.
NEXA_V1_HEALTH_RATE_LIMIT=60
NEXA_V1_HEALTH_RATE_WINDOW_SECONDS=60

# API keys created per hour, per signed-in user (settings UI).
NEXA_API_KEY_CREATE_RATE_LIMIT=10
NEXA_API_KEY_CREATE_RATE_WINDOW_SECONDS=3600

# ---------------------------------------------------------------------------
# Session-authenticated limits. Phase 5.1: these two routes were audited and
# found to reach a *metered* third-party API, so they are limited. The other
# /api/* routes were audited and deliberately left unlimited, because they spend
# no upstream quota and a limit there would cost a database write per call.
# See docs/ENVIRONMENT.md for the per-route reasoning.
# ---------------------------------------------------------------------------

# POST /api/tools, per signed-in user. Bounded because `web_search` spends
# metered search quota and `file_search` runs an unindexed full table scan.
# GET /api/tools is deliberately NOT limited: it serves a static in-memory
# registry and touches neither the network nor the database.
NEXA_TOOLS_RATE_LIMIT=60
NEXA_TOOLS_RATE_WINDOW_SECONDS=60

# POST /api/search, per signed-in user. Every call spends a metered
# Tavily/Brave credential or a SearXNG round trip, so the bound is tighter.
NEXA_SEARCH_RATE_LIMIT=30
NEXA_SEARCH_RATE_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# POST /api/chat (interactive chat). Phase 5.2: this route previously had NO
# limiter at all despite being the most expensive endpoint in the app.
# Lower than the /v1 numbers on purpose: those suit machine clients with an
# API key, while this is one visible message per submitted turn.
# ---------------------------------------------------------------------------

# Per signed-in user. 30/min is far above interactive use and halves the
# worst-case cost of a stolen session.
NEXA_CHAT_USER_RATE_LIMIT=30
NEXA_CHAT_USER_RATE_WINDOW_SECONDS=60

# Per source address. Exactly 2x the user limit, matching the /v1 ratio, so a
# shared NAT (household, office) is not throttled by its other members.
NEXA_CHAT_IP_RATE_LIMIT=60
NEXA_CHAT_IP_RATE_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# POST /api/agents. Phase 5.3: verified that this route reached the same
# web_search / file_search implementations that /api/tools and /api/search
# limit, but by calling ToolExecutor directly, so neither HTTP limiter
# applied. An agent run also writes an agent_runs row and may call a metered
# search provider, so it is now bounded on its own terms.
# ---------------------------------------------------------------------------

# Per signed-in user. An agent run is a deliberate, occasional action rather
# than a conversational turn, so this is lower than the chat limit.
NEXA_AGENT_USER_RATE_LIMIT=20
NEXA_AGENT_USER_RATE_WINDOW_SECONDS=60

# Per source address. 3x the user limit, since one address can legitimately
# cover several accounts behind a shared NAT and agent runs are rare.
NEXA_AGENT_IP_RATE_LIMIT=60
NEXA_AGENT_IP_RATE_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# POST /api/files. Phase 5.4: verified this route had NO application-level
# limit while every accepted upload reads up to 20MB, inserts the raw text,
# chunks it, and runs one embedding per chunk. A loop is both a CPU/IO
# amplifier and unbounded storage growth.
# ---------------------------------------------------------------------------

# Per signed-in user. Uploading is a deliberate, occasional human action, so
# this is lower than the chat limit; 10/min leaves room for a bulk import.
NEXA_FILE_UPLOAD_USER_RATE_LIMIT=10
NEXA_FILE_UPLOAD_USER_RATE_WINDOW_SECONDS=60

# Per source address. 2x the user limit, matching the chat and tools ratios.
NEXA_FILE_UPLOAD_IP_RATE_LIMIT=20
NEXA_FILE_UPLOAD_IP_RATE_WINDOW_SECONDS=60
