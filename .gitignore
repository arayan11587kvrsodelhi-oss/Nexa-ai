node_modules/
.next/
out/
dist/
*.tsbuildinfo
dev-*.log

# Secrets
.env
.env.local
.env*.local

# One-off local scripts that read credential stores from outside the repo.
# These are not part of the application: they open another tool's database and
# print its secrets to stdout. They must never be committed.
read-key.cjs
*-key.cjs
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store
Thumbs.db

# Local FreeLLMAPI runtime (freellmapi/). Only the launcher script and README
# are tracked; the database, logs and any local key material are not. These
# hold the unified API key and must never be committed.
freellmapi/data/
freellmapi/*.db
freellmapi/*.db-shm
freellmapi/*.db-wal
freellmapi/*.sqlite
freellmapi/*.sqlite3
freellmapi/*.log
freellmapi/.env
freellmapi/.encryption-key

.neon
